# Server Configuration
PORT=5000
NODE_ENV=development

# ============================================================
# SQL Server Database Configuration
# ============================================================
# Local Windows Authentication (no DB_USER/DB_PASSWORD needed):
DB_SERVER=YOUR_LOCAL_SERVER_NAME
DB_NAME=sai_automobiles_db

# Production SQL Server Authentication (set these instead of Windows Auth):
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_ENCRYPT=true

# ============================================================
# Security & Authentication Configuration
# ============================================================
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_key

# Login rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# ============================================================
# SMTP Email Configuration (for Forgot Password feature)
# ============================================================
# Configure these to enable password reset emails.
# NEVER commit real credentials to source control.
# Common examples:
#   Gmail:     SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   (use App Password)
#   Outlook:   SMTP_HOST=smtp.office365.com SMTP_PORT=587
#   Zoho:      SMTP_HOST=smtp.zoho.com    SMTP_PORT=587
#   Brevo:     SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sai Srinivasa Automobiles <no-reply@yourdomain.com>
